# Fixture: the four ATTR categories that used to be dropped with a warning.
# Four quads, each under a different state line, all sharing one texture:
#   quad A  - no state (control: plain defaults)
#   quad B  - ATTR_hard asphalt    -> Material > Surface Type = Asphalt
#   quad C  - ATTR_hud_glass       -> Object > HUD Glass = True
#   quad D  - ATTR_depth           -> no XP2B field; custom attribute rides out
TEXTURE	mini.png
POINT_COUNTS	16 0 0 8

VT	0	0	0	0	1	0	0	0
VT	1	0	0	0	1	0	1	0
VT	1	0	1	0	1	0	1	1
VT	0	0	1	0	1	0	0	1
VT	2	0	0	0	1	0	0	0
VT	3	0	0	0	1	0	1	0
VT	3	0	1	0	1	0	1	1
VT	2	0	1	0	1	0	0	1
VT	4	0	0	0	1	0	0	0
VT	5	0	0	0	1	0	1	0
VT	5	0	1	0	1	0	1	1
VT	4	0	1	0	1	0	0	1
VT	6	0	0	0	1	0	0	0
VT	7	0	0	0	1	0	1	0
VT	7	0	1	0	1	0	1	1
VT	6	0	1	0	1	0	0	1
IDX	0 1 2 0 2 3 4 5 6 4 6 7 8 9 10 8 10 11 12 13 14 12 14 15
TRIS	0	6
ATTR_hard	asphalt
TRIS	6	6
ATTR_no_hard
ATTR_hud_glass
TRIS	12	6
ATTR_hud_reset
ATTR_depth
TRIS	18	6
